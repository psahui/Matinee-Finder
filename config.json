{
  "schema": 1,

  "_comment_fetching": "Politeness and crawl limits. request_delay applies only to real network calls, never to cache hits.",
  "request_delay_seconds": 2.0,
  "request_jitter_seconds": 0.8,
  "request_timeout_seconds": 30,
  "max_retries": 3,
  "max_event_pages": 200,

  "_comment_cache": "Days before a cached extraction is refetched. Event pages are tiered by how soon the performance is, because imminent events change and settled ones do not.",
  "cache_ttl_days": {
    "listing": 1,
    "event_near": 2,
    "event_mid": 7,
    "event_far": 14,
    "static_content": 3,
    "failed": 1
  },
  "cache_near_days": 7,
  "cache_mid_days": 60,
  "cache_evict_after_days": 30,

  "_comment_resilience": "Floors are measured on PRE-dedup scrape counts. Willoughby scrapes ~8 performances but contributes 1 after The Concourse supplies exact times for the rest - measuring post-dedup would read a working merge as an outage.",
  "source_floors": {
    "Sydney Symphony Orchestra": 60,
    "Sydney Opera House": 20,
    "Willoughby Symphony": 4,
    "The Concourse": 8,
    "North Sydney Symphony": 2,
    "Salut! Baroque": 2,
    "City Recital Hall": 30,
    "City of Sydney What's On": 5
  },

  "_comment_sydney_opera_house": "Opera House genre listings to read (ids from the What's On genre filter). A genre with a format tags its events with that Event type. Musical Theatre (1456) is deliberately excluded.",
  "sydney_opera_house_genres": [
    { "id": "1436", "label": "Classical Music" },
    { "id": "1441", "label": "Opera", "format": "opera" }
  ],

  "_comment_city_recital_hall": "The hall's own genre labels that count as classical.",
  "city_recital_hall_genres": ["Classical Music", "Opera"],

  "_comment_city_of_sydney": "The guide stopped publishing its 'classical' tag in November 2026, so classical events are picked here: an exclude term in the title, strapline or organiser rules an event out; otherwise a listed composer or include term there, or a description term in the description, rules it in. ignore_phrases are removed first, so 'Opera House' does not count as opera. Terms are regular expressions. Events at venues another source covers are skipped (matched against venue name AND street address, since the guide spells venues its own way).",
  "aggregator_sources": ["City of Sydney What's On"],
  "city_of_sydney": {
    "skip_venues": ["sydney opera house", "bennelong point", "city recital hall", "angel pl",
                    "the concourse", "409 victoria ave"],
    "categories": ["Music & concerts", "Theatre, performances & musicals"],
    "skip_categories": ["talks-and-meetups", "courses-and-workshops"],
    "ignore_phrases": ["opera house", "opera bar", "recital hall"],
    "include_terms": ["classical", "orchestra", "orchestral", "philharmoni\\w*", "symphon\\w+",
                      "chamber (?:music|choir|ensemble|orchestra)", "baroque", "recitals?",
                      "sonatas?", "concertos?", "cantatas?", "oratorio", "requiem", "motets?",
                      "magnificat", "string quartet", "piano duo", "choral", "operas?", "operatic",
                      "soprano", "mezzo", "countertenor", "pianist", "cellist", "violinist",
                      "accordionist", "organist", "musica viva", "omega ensemble",
                      "national academy of music"],
    "description_terms": ["mezzo-soprano", "piano quintet"],
    "exclude_terms": ["jazz", "cabaret", "karaoke", "gospel", "tribute", "big band", "barbershop",
                      "piano bar", "musical theatre", "community christmas", "film", "filmharmonia", "cinema", "hans zimmer", "ballet", "lecture"]
  },
  "source_degrade_ratio": 0.6,
  "global_sanity_ratio": 0.7,
  "stale_max_days": 14,
  "freshness_warn_days": 3,

  "_comment_access": "Who may book. Single-valued, first match by priority wins. Verified against the live sites on 2026-08-07.",
  "access_rules": [
    {
      "id": "schools",
      "label": "Schools only (not publicly bookable)",
      "default_on": false,
      "priority": 10,
      "title_prefixes": ["for schools:"],
      "title_patterns": ["\\bschools?'? (concert|matinee|performance|day)\\b"]
    },
    {
      "id": "participants",
      "label": "You perform, not watch",
      "default_on": false,
      "priority": 20,
      "title_patterns": [
        "\\bworkshop\\b",
        "young musicians",
        "junior strings",
        "\\bcome and sing\\b",
        "\\bplay ?along\\b",
        "\\baudition"
      ]
    }
  ],
  "access_default": "public",
  "access_public_label": "Publicly bookable",

  "_comment_review": "Titles hinting at restricted access that no access rule caught. Surfaced as a checkbox so a misclassification never silently sends someone to a venue they cannot enter.",
  "needs_review_patterns": [
    "\\bschools?\\b",
    "\\bstudents?\\b",
    "\\beducation\\b",
    "\\baudition\\b",
    "\\bworkshop\\b"
  ],

  "_comment_format": "What kind of event. Multi-valued - all matching rules apply, because e.g. a film-in-concert can also be a family event.",
  "format_rules": [
    {
      "id": "open_rehearsal",
      "label": "Open rehearsal",
      "default_on": true,
      "title_patterns": ["open rehearsal"]
    },
    {
      "id": "masterclass",
      "label": "Masterclass",
      "default_on": true,
      "title_patterns": ["master ?class"]
    },
    {
      "id": "film",
      "label": "Film in concert",
      "default_on": true,
      "title_patterns": [
        "\\bin concert\\b",
        "star wars",
        "harry potter",
        "lord of the rings",
        "\\blive to film\\b"
      ]
    },
    {
      "id": "family",
      "label": "Family / children",
      "default_on": true,
      "title_patterns": [
        "carnival of the animals",
        "ready,? ?set,? ?listen",
        "\\bfamil(y|ies)\\b",
        "\\bkids?\\b",
        "babies proms",
        "peter and the wolf",
        "spirited away"
      ]
    },
    {
      "id": "opera",
      "label": "Opera",
      "default_on": true,
      "title_patterns": []
    },
    {
      "id": "short_format",
      "label": "Short format (lunchtime, cocktail hour)",
      "default_on": true,
      "title_patterns": [
        "cocktail hour",
        "live at lunch",
        "lunchtime",
        "morning masters"
      ]
    }
  ],
  "format_default": "concert",
  "format_default_label": "Concert",

  "_comment_dayparts": "Time-of-day bands. Anything before 17:00 is a matinee; the frontend exposes that as a quick link over these bands.",
  "dayparts": [
