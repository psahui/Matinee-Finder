    "max_walk_minutes": 15,
    "venues": [
      { "match": ["sydney town hall", "483 george st"], "station": "Gadigal", "minutes": 4 },
      { "match": ["city recital hall", "angel pl"], "station": "Martin Place", "minutes": 5 },
      { "match": ["173 king st", "st james' king st", "st james king st"], "station": "Martin Place", "minutes": 5 },
      { "match": ["queen victoria building", "455 george st"], "station": "Gadigal", "minutes": 5 },
      { "match": ["church st, north sydney"], "station": "Victoria Cross", "minutes": 6 },
      { "match": ["the concourse", "409 victoria ave"], "station": "Chatswood", "minutes": 7 },
      { "match": ["the neilson", "walsh bay", "dawes point"], "station": "Barangaroo", "minutes": 9 },
      { "match": ["verbrugghen", "conservatorium"], "station": "Martin Place", "minutes": 10 },
      { "match": ["st philip's church york st", "st philip's york st", "3 york st"], "station": "Barangaroo", "minutes": 10 },
      { "match": ["smith auditorium", "shore school"], "station": "Victoria Cross", "minutes": 10 },
      { "match": ["st leonards park"], "station": "Victoria Cross", "minutes": 11 },
      { "match": ["north sydney girls"], "station": "Crows Nest", "minutes": 15 },
      { "match": ["sydney opera house", "bennelong point"], "station": "Martin Place", "minutes": 18, "include": true }
