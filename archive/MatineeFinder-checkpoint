    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "Sydney Matinee Music Finder v1.0\n",
    "A script to find and highlight matinee classical music performances in Sydney\n",
    "Author: Created for personal, non-commercial use\n",
    "Date: September 2025\n",
    "\"\"\"\n",
    "\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "from datetime import datetime, time\n",
    "import time as time_module\n",
    "import re\n",
    "from typing import List, Dict, Optional\n",
    "import logging\n",
    "\n",
    "# Set up logging for error tracking\n",
    "logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n",
    "\n",
    "# Define custom User-Agent for polite web scraping\n",
    "USER_AGENT = 'SydneyMatineeFinder/1.0 (Bot for personal, non-commercial use)'\n",
    "HEADERS = {'User-Agent': USER_AGENT}\n",
    "\n",
    "# Define matinee cutoff time (before 5:00 PM)\n",
    "MATINEE_CUTOFF = time(17, 0)  # 5:00 PM in 24-hour format\n",
    "\n",
    "class Performance:\n",
    "    \"\"\"Class to store performance information\"\"\"\n",
    "    def __init__(self, orchestra: str, title: str, date_str: str, time_str: str, \n",
    "                 venue: str, url: str):\n",
    "        self.orchestra = orchestra\n",
    "        self.title = title\n",
    "        self.date_str = date_str\n",
    "        self.time_str = time_str\n",
    "        self.venue = venue\n",
    "        self.url = url\n",
    "        self.datetime_obj = None\n",
    "        self.is_matinee = False\n",
    "        \n",
    "        # Try to parse the date and time for sorting\n",
    "        self._parse_datetime()\n",
    "        \n",
    "        # Determine if this is a matinee performance\n",
    "        self._check_matinee()\n",
    "    \n",
    "    def _parse_datetime(self):\n",
    "        \"\"\"Parse date and time strings into datetime object for sorting\"\"\"\n",
    "        try:\n",
    "            # This is a simplified parser - you may need to adjust based on actual formats\n",
    "            date_formats = ['%d %B %Y', '%d/%m/%Y', '%Y-%m-%d', '%d %b %Y']\n",
    "            for fmt in date_formats:\n",
    "                try:\n",
    "                    date_obj = datetime.strptime(self.date_str, fmt)\n",
    "                    # Try to parse time\n",
    "                    time_formats = ['%I:%M%p', '%I:%M %p', '%H:%M', '%I%p', '%I %p']\n",
    "                    for time_fmt in time_formats:\n",
    "                        try:\n",
    "                            time_obj = datetime.strptime(self.time_str.upper(), time_fmt).time()\n",
    "                            self.datetime_obj = datetime.combine(date_obj.date(), time_obj)\n",
    "                            break\n",
    "                        except:\n",
    "                            continue\n",
    "                    break\n",
    "                except:\n",
    "                    continue\n",
    "        except Exception as e:\n",
    "            logging.debug(f\"Could not parse date/time for {self.title}: {e}\")\n",
    "    \n",
    "    def _check_matinee(self):\n",
    "        \"\"\"Check if performance is a matinee (before 5:00 PM)\"\"\"\n",
    "        if self.datetime_obj:\n",
    "            self.is_matinee = self.datetime_obj.time() < MATINEE_CUTOFF\n",
    "        elif self.time_str:\n",
    "            # Try simple pattern matching if datetime parsing failed\n",
    "            time_match = re.search(r'(\\d{1,2}):?(\\d{0,2})\\s*(am|pm)?', self.time_str.lower())\n",
    "            if time_match:\n",
    "                hour = int(time_match.group(1))\n",
    "                period = time_match.group(3)\n",
    "                if period == 'am' or (period == 'pm' and hour < 5):\n",
    "                    self.is_matinee = True\n",
    "\n",
    "def safe_request(url: str, timeout: int = 10) -> Optional[requests.Response]:\n",
    "    \"\"\"\n",
    "    Make a safe HTTP request with error handling\n",
    "    \n",
    "    Args:\n",
    "        url: The URL to request\n",
    "        timeout: Request timeout in seconds\n",
    "    \n",
    "    Returns:\n",
    "        Response object or None if error\n",
    "    \"\"\"\n",
    "    try:\n",
    "        response = requests.get(url, headers=HEADERS, timeout=timeout)\n",
    "        response.raise_for_status()\n",
    "        return response\n",
    "    except requests.RequestException as e:\n",
    "        logging.error(f\"Error fetching {url}: {e}\")\n",
    "        return None\n",
    "\n",
    "def scrape_sydney_opera_house() -> List[Performance]:\n",
    "    \"\"\"\n",
    "    Scrape upcoming classical performances from Sydney Opera House\n",
    "    \n",
    "    Returns:\n",
    "        List of Performance objects\n",
    "    \"\"\"\n",
    "    performances = []\n",
    "    base_url = \"https://www.sydneyoperahouse.com\"\n",
    "    \n",
    "    try:\n",
    "        # Search for classical music events\n",
    "        url = f\"{base_url}/whats-on?genres=classical-music\"\n",
    "        response = safe_request(url)\n",
    "        \n",
    "        if not response:\n",
    "            logging.warning(\"Could not scrape Sydney Opera House\")\n",
    "            return performances\n",
    "        \n",
    "        soup = BeautifulSoup(response.content, 'html.parser')\n",
    "        \n",
    "        # Note: The actual selectors will need to be updated based on the current website structure\n",
    "        # This is a template showing the scraping pattern\n",
    "        event_cards = soup.find_all('div', class_='event-card')[:10]  # Limit to first 10 for safety\n",
    "        \n",
    "        for card in event_cards:\n",
    "            try:\n",
    "                title_elem = card.find('h3', class_='event-title')\n",
    "                date_elem = card.find('span', class_='event-date')\n",
    "                time_elem = card.find('span', class_='event-time')\n",
    "                link_elem = card.find('a', href=True)\n",
    "                \n",
    "                if title_elem and date_elem:\n",
    "                    performance = Performance(\n",
    "                        orchestra=\"Sydney Opera House\",\n",
    "                        title=title_elem.get_text(strip=True),\n",
    "                        date_str=date_elem.get_text(strip=True),\n",
    "                        time_str=time_elem.get_text(strip=True) if time_elem else \"TBA\",\n",
    "                        venue=\"Sydney Opera House, Bennelong Point, Sydney NSW 2000\",\n",
    "                        url=base_url + link_elem['href'] if link_elem else url\n",
    "                    )\n",
    "                    performances.append(performance)\n",
    "            except Exception as e:\n",
    "                logging.debug(f\"Error parsing event card: {e}\")\n",
    "                continue\n",
    "                \n",
    "    except Exception as e:\n",
    "        logging.error(f\"Error scraping Sydney Opera House: {e}\")\n",
    "    \n",
    "    # Be polite - wait before next request\n",
    "    time_module.sleep(2)\n",
    "    return performances\n",
    "\n",
